# ===== Google Sheets / Drive (Service Account) =====
# สร้าง Service Account ใน Google Cloud Console > IAM > Service Accounts
# เปิดใช้ Google Sheets API + Google Drive API ในโปรเจกต์
# แชร์ Google Sheet และ Drive Folder (ถ้าจะใช้โฟลเดอร์ที่มีอยู่แล้ว) ให้กับอีเมลของ Service Account (สิทธิ์ Editor)
GOOGLE_SERVICE_ACCOUNT_EMAIL=xxxx@xxxx.iam.gserviceaccount.com
# วาง private key ทั้งก้อน (คง \n ไว้ในบรรทัดเดียว) — คัดลอกจากไฟล์ JSON ของ Service Account
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# รหัส Spreadsheet (เอาจาก URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit)
SPREADSHEET_ID=

# ===== PIN =====
REVIEWER_PIN=1212312121
ADMIN_PIN=1212312121

# ===== App =====
PORT=3000
